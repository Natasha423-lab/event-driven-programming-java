<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.MainController">

    <left>
        <VBox spacing="20" prefWidth="180"
              style="-fx-background-color: #263238; -fx-padding: 20;">

            <Label text="UNIVERSITY SYSTEM"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Button text="Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity"/>

            <Button text="Students" onAction="#showStudents"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <Label text="Welcome to the University Management System"
                   style="-fx-font-size: 20px;"/>
        </StackPane>
    </center>

</BorderPane>
